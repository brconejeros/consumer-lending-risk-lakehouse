# Copy to terraform.tfvars (gitignored) and fill in real values.
# postgres_admin_password must match infra/terraform/platform's terraform.tfvars.
#
# airbyte_bearer_token is NOT set here - it's short-lived (~15 min), fetch a
# fresh one with `eval "$(./get_token.sh)"` immediately before every
# plan/apply instead (see get_token.sh and versions.tf).

airbyte_client_id        = "00000000-0000-0000-0000-000000000000"
airbyte_client_secret    = "changeme"
postgres_admin_password  = "changeme"
databricks_client_id     = "00000000-0000-0000-0000-000000000000"
databricks_client_secret = "changeme"
