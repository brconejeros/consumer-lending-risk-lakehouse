{
  "datasets": [
    {
      "name": "ds_total_applications",
      "displayName": "Total applications",
      "queryLines": [
        "SELECT COUNT(*) AS total_applications FROM consumer_lending_risk_lakehouse.gold.fact_application WHERE SampleTypeCd = 'TRAIN'"
      ]
    },
    {
      "name": "ds_overall_default_rate",
      "displayName": "Overall default rate",
      "queryLines": [
        "SELECT ROUND(AVG(Target) * 100, 2) AS overall_default_rate_pct FROM consumer_lending_risk_lakehouse.gold.fact_application WHERE SampleTypeCd = 'TRAIN'"
      ]
    },
    {
      "name": "ds_risk_by_segment",
      "displayName": "Default rate by income segment",
      "queryLines": [
        "SELECT IncomeTypeCd AS segment, COUNT(*) AS applicant_cnt, ROUND(AVG(Target) * 100, 2) AS default_rate_pct FROM consumer_lending_risk_lakehouse.gold.fact_application WHERE SampleTypeCd = 'TRAIN' GROUP BY IncomeTypeCd ORDER BY default_rate_pct DESC"
      ]
    },
    {
      "name": "ds_risk_by_income_age_band",
      "displayName": "Default rate by income/age band",
      "queryLines": [
        "SELECT CASE WHEN IncomeTotalAmt < 100000 THEN '1. <100K' WHEN IncomeTotalAmt < 150000 THEN '2. 100-150K' WHEN IncomeTotalAmt < 200000 THEN '3. 150-200K' WHEN IncomeTotalAmt < 300000 THEN '4. 200-300K' ELSE '5. 300K+' END AS income_band, CASE WHEN -BirthDays / 365.25 < 25 THEN '1. <25' WHEN -BirthDays / 365.25 < 35 THEN '2. 25-34' WHEN -BirthDays / 365.25 < 45 THEN '3. 35-44' WHEN -BirthDays / 365.25 < 55 THEN '4. 45-54' WHEN -BirthDays / 365.25 < 65 THEN '5. 55-64' ELSE '6. 65+' END AS age_band, COUNT(*) AS applicant_cnt, ROUND(AVG(Target) * 100, 2) AS default_rate_pct FROM consumer_lending_risk_lakehouse.gold.fact_application WHERE SampleTypeCd = 'TRAIN' GROUP BY income_band, age_band ORDER BY income_band, age_band"
      ]
    },
    {
      "name": "ds_application_drilldown",
      "displayName": "Application drill-down",
      "queryLines": [
        "SELECT f.CurrId, f.SampleTypeCd, f.Target, f.GenderCd, ROUND(-f.BirthDays / 365.25, 1) AS AgeYears, f.IncomeTypeCd, f.EducationTypeCd, f.FamilyStatusCd, f.HousingTypeCd, f.IncomeTotalAmt, f.CreditAmt, f.AnnuityAmt, b.BureauCnt, b.BureauActiveCnt, b.CreditSumDebtAmtSum, p.PrevApplicationCnt, p.ApprovedCnt, p.RefusedCnt, i.InstallmentCnt, i.LateInstallmentCnt, i.PaymentRatioAvg, c.CreditCardCnt, c.UtilizationRatioAvg FROM consumer_lending_risk_lakehouse.gold.fact_application f LEFT JOIN consumer_lending_risk_lakehouse.gold.dim_bureau b ON f.CurrId = b.CurrId LEFT JOIN consumer_lending_risk_lakehouse.gold.dim_previous_application p ON f.CurrId = p.CurrId LEFT JOIN consumer_lending_risk_lakehouse.gold.dim_installments_agg i ON f.CurrId = i.CurrId LEFT JOIN consumer_lending_risk_lakehouse.gold.dim_credit_card_agg c ON f.CurrId = c.CurrId WHERE (:applicant_id IS NULL OR f.CurrId = :applicant_id) ORDER BY f.CurrId LIMIT 500"
      ],
      "parameters": [
        {
          "displayName": "applicant_id",
          "keyword": "applicant_id",
          "dataType": "STRING",
          "defaultSelection": {}
        }
      ]
    }
  ],
